{
  "name": "dsh-plugin-conversation-archive",
  "version": "1.0.3",
  "description": "把每次对话的产出文件归入工作区里一个 <日期>_<主题> 文件夹，而不是散落在根目录。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "bundle",
    "archive",
    "folders",
    "workspace"
  ],
  "license": "MIT",
  "author": "clumsy-dot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clumsy-dot/dsh-plugin-conversation-archive.git"
  },
  "homepage": "https://github.com/clumsy-dot/dsh-plugin-conversation-archive#readme",
  "bugs": {
    "url": "https://github.com/clumsy-dot/dsh-plugin-conversation-archive/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
